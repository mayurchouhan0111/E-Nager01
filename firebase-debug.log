[debug] [2026-11-12T17:43:34.427Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-test:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions for security validation\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function hasRequiredFields(requiredFields) {\n      return request.resource.data.keys().hasAll(requiredFields);\n    }\n    \n    function isValidStatus(status) {\n      return status in ['Submitted', 'Under Review', 'Correction Requested', 'Approved', 'Rejected', 'Certificate Generated', 'Completed', 'Sanctioned'];\n    }\n\n    // Death Certificates Collection\n    match /deathCertificates/{docId} {\n      // Citizens can submit new applications with required fields\n      allow create: if hasRequiredFields(['applicationNo', 'deceasedDetails', 'applicantDetails', 'status'])\n                    && request.resource.data.status == 'Submitted';\n      \n      // Restrict bulk listing to authenticated users, allow single document get by appNo query\n      allow list: if isAuthenticated();\n      allow get: if true;\n\n      // Allow status updates by authenticated admin users only\n      allow update: if isAuthenticated() && isValidStatus(request.resource.data.status);\n      \n      // Disallow unauthorized deletion\n      allow delete: if false;\n    }\n\n    // Birth Certificates Collection\n    match /birthCertificates/{docId} {\n      // Citizens can submit new applications with required fields\n      allow create: if hasRequiredFields(['applicationNo', 'childDetails', 'applicantDetails', 'status'])\n                    && request.resource.data.status == 'Submitted';\n      \n      // Restrict bulk listing to authenticated users, allow single document get by appNo query\n      allow list: if isAuthenticated();\n      allow get: if true;\n\n      // Allow status updates by authenticated admin users only\n      allow update: if isAuthenticated() && isValidStatus(request.resource.data.status);\n      \n      // Disallow unauthorized deletion\n      allow delete: if false;\n    }\n\n    // Water Connections Collection\n    match /waterConnections/{docId} {\n      // Citizens can submit new applications with required fields\n      allow create: if hasRequiredFields(['applicationNo', 'applicantDetails', 'propertyDetails', 'status'])\n                    && request.resource.data.status == 'Submitted';\n      \n      // Restrict bulk listing to authenticated users, allow single document get by appNo query\n      allow list: if isAuthenticated();\n      allow get: if true;\n\n      // Allow status updates by authenticated admin users only\n      allow update: if isAuthenticated() && isValidStatus(request.resource.data.status);\n      \n      // Disallow unauthorized deletion\n      allow delete: if false;\n    }\n\n    // Property Tax No Dues NOC Collection\n    match /noDuesCertificates/{docId} {\n      // Citizens can submit new applications with required fields\n      allow create: if hasRequiredFields(['applicationNo', 'applicantDetails', 'propertyDetails', 'status'])\n                    && request.resource.data.status == 'Submitted';\n      \n      // Restrict bulk listing to authenticated users, allow single document get by appNo query\n      allow list: if isAuthenticated();\n      allow get: if true;\n\n      // Allow status updates by authenticated users or payment update\n      allow update: if (isAuthenticated() || request.resource.data.paymentStatus == 'Paid') && isValidStatus(request.resource.data.status);\n      \n      // Disallow unauthorized deletion\n      allow delete: if false;\n    }\n\n    // Audit Logs Collection (Compliance & Security Audit Trail)\n    match /auditLogs/{docId} {\n      allow create: if request.resource.data.keys().hasAll(['action', 'timestamp']);\n      allow read: if isAuthenticated();\n      allow update, delete: if false; // Audit logs are immutable\n    }\n\n    match /audit_logs/{docId} {\n      allow create: if request.resource.data.keys().hasAll(['action', 'timestamp']);\n      allow read: if isAuthenticated();\n      allow update, delete: if false; // Audit logs are immutable\n    }\n\n    // Notifications Collection\n    match /notifications/{docId} {\n      allow create: if true;\n      allow read: if true;\n      allow update: if isAuthenticated();\n      allow delete: if false;\n    }\n\n    // Admin Settings Collection\n    match /admin_settings/{docId} {\n      // Maintenance status must be publicly readable so MaintenanceGuard can protect citizen views\n      allow read: if docId == 'maintenance' || isAuthenticated();\n      allow write: if isAuthenticated();\n    }\n\n    // Grievances & Citizen Complaints (DPDP Act)\n    match /grievances/{docId} {\n      allow create: if request.resource.data.keys().hasAll(['ticketNo', 'fullName', 'mobile', 'description', 'status'])\n                    && request.resource.data.status == 'Open';\n      allow read: if isAuthenticated() || true;\n      allow update: if isAuthenticated();\n      allow delete: if false;\n    }\n\n    // Default deny all other collections\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n"}]}}
